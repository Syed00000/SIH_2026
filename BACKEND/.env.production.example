# ===================================================
# JOHARSETU BACKEND VERCEL PRODUCTION ENVIRONMENT CONFIGURATION
# ===================================================

# Environment Mode
NODE_ENV=production
PORT=3000

# MongoDB Atlas Connection String (Primary)
URL=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/joharsetu?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/joharsetu?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate secure 32+ character strings)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Allowed Origins (Set your Vercel frontend domain or * to allow all)
CORS_ORIGINS=*

# Government Default Super Administrator Credentials
GOVT_ADMIN_NAME=Government Super Administrator
GOVT_ADMIN_EMAIL=admin@jharkhand.gov.in
GOVT_ADMIN_PASSWORD=YourSecureAdminPassword123!
GOVT_ADMIN_MOBILE=9876543210

# State Nodal Administrator Password
DEFAULT_NODAL_PASSWORD=YourSecureNodalPassword123!

# Cloudinary Cloud Storage (Required for serverless file uploads & PDF evidence)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Optional Email / SMTP Notifications
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Map API Token
CARTO_API_KEY=cb1_3yhz_1_e7b1c7f6e22a991f83004a14
