# ===================================================
# JOHARSETU FRONTEND ENVIRONMENT CONFIGURATION
# ===================================================

# Backend API Base URL (Must include /api/v1/)
# Local Development: http://127.0.0.1:3000/api/v1/
# Vercel Production: https://your-backend.vercel.app/api/v1/
VITE_API_BASE_URL=http://127.0.0.1:3000/api/v1/

# Backend Root URL (Without trailing slash; used for Socket.IO & static media streaming)
# Local Development: http://127.0.0.1:3000
# Vercel Production: https://your-backend.vercel.app
VITE_BACKEND_URL=http://127.0.0.1:3000

# Socket.IO Server URL (Defaults to VITE_BACKEND_URL)
VITE_SOCKET_URL=http://127.0.0.1:3000

# API Request Timeout in milliseconds (Default: 15000)
VITE_API_TIMEOUT=15000

# MapTiler / Carto map tile token (optional fallback provided in code)
VITE_CARTO_API_KEY=cb1_3yhz_1_e7b1c7f6e22a991f83004a14
